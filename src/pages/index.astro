---
import Base from '../layouts/base.astro';
---
<Base>
  <header class="flex items-center gap-4">
    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-accent font-display text-lg font-semibold text-accent" title="Elder Futhark runes for R and F (Raido, Feh)">ᚱᚠ</span>
    <h1 class="font-display text-3xl font-semibold tracking-tight">Robin Foster</h1>
  </header>

  <section class="mt-10">
    <h2 class="font-display text-lg font-semibold">About me <span class="text-accent" aria-hidden="true">✦</span></h2>
    <p class="mt-3 text-ink-soft">
      I build tools as personal projects to understand how AI is changing development
      and computer use.
    </p>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-lg font-semibold">Interests <span class="text-accent" aria-hidden="true">✦</span></h2>
    <p class="mt-3 text-ink-soft">
      Harness engineering, local AI, and business automation.
    </p>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-lg font-semibold">Links <span class="text-accent" aria-hidden="true">✦</span></h2>
    <ul class="mt-3 space-y-2">
      <li><a class="text-accent hover:underline" href="https://github.com/robinfoster1996">GitHub</a></li>
      <li><a class="text-accent hover:underline" href="mailto:robinfoster1996@gmail.com">robinfoster1996@gmail.com</a></li>
      <li><a class="text-accent hover:underline" href="/privacy">Privacy Policy</a></li>
    </ul>
  </section>
</Base>
