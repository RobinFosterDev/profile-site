---
import '../styles/global.css';
const { title = 'Robin Foster' } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Robin Foster — profile, projects, and privacy policy." />
  </head>
  <body class="min-h-dvh bg-white text-slate-900 antialiased">
    <main class="mx-auto max-w-2xl px-6 py-16">
      <slot />
    </main>
    <footer class="mx-auto max-w-2xl px-6 pb-12 text-sm text-slate-500">
      <nav class="flex items-center gap-4">
        <a class="hover:text-slate-900" href="/">Home</a>
        <a class="hover:text-slate-900" href="/privacy/">Privacy</a>
        <span class="ml-auto text-accent" aria-hidden="true">☾</span>
      </nav>
      <p class="mt-4">
        © {year} Robin Foster — typeset on RCServer, an AMD Radeon R9700 home
        server with a local model as collaborator
        <span class="text-accent" aria-hidden="true">✦</span>
      </p>
    </footer>
  </body>
</html>
